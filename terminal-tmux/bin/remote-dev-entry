#!/usr/bin/env bash

set -euo pipefail

# 远程交互入口：先选择宿主机还是 Docker，再进入对应环境的 tmux。
#
# 核心约束：
#   - 宿主机分支直接 exec 宿主机 tmux。
#   - 容器分支直接 exec docker exec，tmux 只在容器内启动。
#   - 两个分支都不保留外层 shell/宿主机 tmux，避免多层 tmux 嵌套。
#   - 所有交互界面都监听 WINCH，终端缩放后会清屏并重新居中。

# 可在运行脚本前通过环境变量改名，默认两边都使用 dev。
HOST_TMUX_SESSION=${HOST_TMUX_SESSION:-dev}
CONTAINER_TMUX_SESSION=${CONTAINER_TMUX_SESSION:-dev}

fail() {
  printf 'remote-dev-entry：%s\n' "$*" >&2
  exit 1
}

fallback_ghostty_term() {
  # Ghostty 使用 xterm-ghostty 描述完整终端能力。较旧的远端系统尚未内置
  # 该 terminfo 时再回退到普遍可用的 xterm-256color；已有条目时不降级。
  if [[ ${TERM:-} == xterm-ghostty ]] &&
    { ! command -v infocmp >/dev/null 2>&1 || ! infocmp xterm-ghostty >/dev/null 2>&1; }; then
    export TERM=xterm-256color
  fi
}

sync_bridge_tmux_environment() {
  # 已存在的 tmux server 不会自动接收自定义 SSH 会话变量。把连接脚本传来的
  # SFTP bridge 变量写入 tmux 全局环境，让已有 pane 也能读取。
  local variable value
  for variable in TERMSCP_MAC_USER TERMSCP_REVERSE_PORT TERMSCP_MAC_HOST; do
    value=${!variable:-}
    [[ -n "$value" ]] || continue
    tmux set-environment -g "$variable" "$value" 2>/dev/null || true
  done
}

valid_termscp_port() {
  local port=$1
  [[ "$port" =~ ^[0-9]{1,5}$ ]] || return 1
  (( 10#$port >= 1 && 10#$port <= 65535 ))
}

authorize_termscp_container_key() {
  local container_id=$1 container_name=$2 mac_host=$3 authorization_port public_key
  local authorization_label remote_host

  [[ -n ${TERMSCP_AUTH_TOKEN:-} ]] || return 0
  authorization_port=${TERMSCP_AUTH_REVERSE_PORT:-6023}
  valid_termscp_port "$authorization_port" || {
    printf '授权反向端口无效：%s\n' "$authorization_port" >&2
    return 1
  }
  [[ -x "$HOME/.local/bin/termscp-key-authorizer" ]] || {
    printf '%s\n' '找不到远端 termscp-key-authorizer' >&2
    return 1
  }

  # 新旧容器都使用独立的 termscp 身份。首次进入时自动生成密钥，并维护一个
  # 专用 SSH Host；绝不读取、覆盖或删除容器已有的 ~/.ssh/id_ed25519。
  # 这里不能使用登录 shell：部分容器的 /etc/profile 会向 stdout 输出提示或
  # ANSI 控制码，混入 ssh-keygen 的结果后会被 Mac 误判成公钥类型。
  public_key=$(docker exec "$container_id" sh -c '
    mac_host=$1
    mac_port=$2
    mac_user=$3
    ssh_directory="$HOME/.ssh"
    key_path="$ssh_directory/termscp_mac_ed25519"
    config_path="$ssh_directory/config"
    begin_marker="# BEGIN dotfiles termscp-mac"
    end_marker="# END dotfiles termscp-mac"

    command -v ssh-keygen >/dev/null 2>&1 || {
      printf "%s\n" "容器内未安装 ssh-keygen" >&2
      exit 127
    }
    command -v awk >/dev/null 2>&1 || {
      printf "%s\n" "容器内未安装 awk" >&2
      exit 127
    }
    [ ! -L "$ssh_directory" ] && [ ! -L "$key_path" ] && [ ! -L "$config_path" ] || {
      printf "%s\n" "拒绝通过符号链接写入容器 SSH 配置" >&2
      exit 1
    }

    umask 077
    mkdir -p "$ssh_directory"
    chmod 700 "$ssh_directory"
    if [ ! -e "$key_path" ]; then
      ssh-keygen -q -t ed25519 -N "" -C "termscp-mac" -f "$key_path" || {
        printf "%s\n" "无法生成容器 termscp 专用密钥" >&2
        exit 1
      }
    fi
    [ -f "$key_path" ] && [ -r "$key_path" ] || {
      printf "容器 termscp 私钥不可读：%s\n" "$key_path" >&2
      exit 1
    }
    chmod 600 "$key_path"

    config_temporary=$(mktemp "$ssh_directory/.termscp-config.XXXXXX") || {
      printf "%s\n" "无法创建临时 SSH 配置" >&2
      exit 1
    }
    config_final=$(mktemp "$ssh_directory/.termscp-config.XXXXXX") || {
      rm -f "$config_temporary"
      printf "%s\n" "无法创建最终 SSH 配置" >&2
      exit 1
    }
    trap '\''rm -f "$config_temporary" "$config_final"'\'' 0 1 2 15
    if [ -e "$config_path" ]; then
      [ -f "$config_path" ] && [ -r "$config_path" ] || {
        printf "容器 SSH 配置不可读：%s\n" "$config_path" >&2
        exit 1
      }
      awk -v begin="$begin_marker" -v end="$end_marker" '\''
        $0 == begin {
          if (managed) exit 42
          managed = 1
          next
        }
        $0 == end {
          if (!managed) exit 43
          managed = 0
          next
        }
        !managed { print }
        END { if (managed) exit 44 }
      '\'' "$config_path" > "$config_temporary" || {
        printf "%s\n" "容器 SSH 配置中的 termscp 受管区块不完整" >&2
        exit 1
      }
    fi
    # OpenSSH 对大多数参数采用“第一个获得的值”。专用 Host 必须放在原有
    # `Host *` 等通配规则之前，才能保证 IdentityFile 不被通用配置抢先覆盖。
    {
      printf "%s\n" "$begin_marker"
      printf "%s\n" "Host dotfiles-termscp-mac"
      printf "    HostName %s\n" "$mac_host"
      printf "    Port %s\n" "$mac_port"
      printf "    User %s\n" "$mac_user"
      printf "    IdentityFile %s\n" "$key_path"
      printf "%s\n" "    IdentitiesOnly yes"
      printf "%s\n" "$end_marker"
      if [ -s "$config_temporary" ]; then
        printf "\n"
        cat "$config_temporary"
      fi
    } > "$config_final"
    chmod 600 "$config_final"
    mv -f "$config_final" "$config_path"
    rm -f "$config_temporary"
    trap - 0 1 2 15

    ssh-keygen -y -f "$key_path"
  ' sh "$mac_host" "${TERMSCP_REVERSE_PORT:-6022}" "$TERMSCP_MAC_USER") || return 1

  remote_host=${TERMSCP_REMOTE_HOST:-remote}
  authorization_label="$remote_host/$container_name"
  termscp-key-authorizer request \
    --host 127.0.0.1 \
    --port "$authorization_port" \
    --token "$TERMSCP_AUTH_TOKEN" \
    --public-key "$public_key" \
    --label "$authorization_label"
}

start_container_bridge_relay() {
  local container_id=$1 service_name=$2 listen_port=$3 target_port=$4
  local network_container network_mode gateway
  local relay relay_ready relay_log relay_pid relay_status ready_port attempt relay_error
  network_mode=$(docker inspect -f '{{.HostConfig.NetworkMode}}' "$container_id") || \
    fail "无法读取所选容器的网络模式"

  # host 网络与宿主机共用 127.0.0.1，不需要中继。bridge/custom network 则
  # 只监听该 Docker 网关地址，不把 Mac SFTP 暴露到服务器的物理网卡。
  if [[ "$network_mode" == host ]]; then
    bridge_relay_host=127.0.0.1
    return 0
  fi

  network_container=$container_id
  if [[ "$network_mode" == container:* ]]; then
    network_container=${network_mode#container:}
  fi
  gateway=$(docker inspect -f \
    '{{range .NetworkSettings.Networks}}{{if .Gateway}}{{.Gateway}}{{println}}{{end}}{{end}}' \
    "$network_container" | sed -n '/./{p;q;}') || \
    fail "无法读取所选容器的 Docker 网关"
  [[ -n "$gateway" ]] || fail "所选容器没有可用的 Docker 网关，无法连接 Mac $service_name"
  [[ "$gateway" =~ ^[0-9A-Fa-f:.]+$ ]] || fail "Docker 网关地址无效：$gateway"

  relay="$HOME/.local/bin/termscp-bridge-relay"
  [[ -x "$relay" ]] || fail "找不到 $relay；请重新运行 connect-remote-dev"
  command -v python3 >/dev/null 2>&1 || fail "服务器宿主机未安装 python3"

  relay_ready=$(mktemp "${TMPDIR:-/tmp}/termscp-relay.XXXXXX")
  relay_log="${relay_ready}.log"
  python3 "$relay" \
    --listen-host "$gateway" \
    --listen-port "$listen_port" \
    --target-host 127.0.0.1 \
    --target-port "$target_port" \
    --parent-pid "$$" \
    --ready-file "$relay_ready" </dev/null >"$relay_log" 2>&1 &
  relay_pid=$!

  for ((attempt = 0; attempt < 100; attempt++)); do
    [[ -s "$relay_ready" ]] && break
    kill -0 "$relay_pid" 2>/dev/null || break
    sleep 0.02
  done

  if [[ ! -s "$relay_ready" ]]; then
    relay_error=$(<"$relay_log")
    kill "$relay_pid" 2>/dev/null || true
    wait "$relay_pid" 2>/dev/null || true
    rm -f "$relay_ready" "$relay_log"
    fail "无法为容器启动 $service_name 中继${relay_error:+：$relay_error}"
  fi

  read -r relay_status ready_port < "$relay_ready"
  if [[ "$relay_status" != READY ]] || ! valid_termscp_port "$ready_port" ||
    (( 10#$ready_port != 10#$listen_port )); then
    kill "$relay_pid" 2>/dev/null || true
    wait "$relay_pid" 2>/dev/null || true
    rm -f "$relay_ready" "$relay_log"
    fail "$service_name 容器中继没有正确就绪"
  fi
  rm -f "$relay_ready" "$relay_log"
  bridge_relay_host=$gateway
}

start_termscp_container_relay() {
  local container_id=$1 reverse_port bridge_relay_host

  # 普通 SSH 入口没有 Mac 反向隧道，仍允许用户进入容器；termscp-mac 会给出
  # 重新通过 ghostty-dev/connect-remote-dev 连接的明确提示。
  [[ -n ${TERMSCP_MAC_USER:-} ]] || return 0
  reverse_port=${TERMSCP_REVERSE_PORT:-6022}
  valid_termscp_port "$reverse_port" || fail "无效的 termscp 反向端口：$reverse_port"
  start_container_bridge_relay "$container_id" SFTP "$reverse_port" "$reverse_port"
  termscp_mac_host=$bridge_relay_host
}

enter_host_tmux() {
  # exec 会让 tmux 取代入口脚本，SSH 退出时不留额外进程。
  local zsh_path shell_command zsh_pane zsh_window pane_id pane_command
  fallback_ghostty_term
  command -v tmux >/dev/null 2>&1 || fail "宿主机未安装 tmux"
  command -v zsh >/dev/null 2>&1 || fail "宿主机未安装 zsh"
  zsh_path=$(command -v zsh)
  if [[ -x "$HOME/.local/bin/tmux-zsh" ]]; then
    shell_command="$HOME/.local/bin/tmux-zsh"
  else
    shell_command="$zsh_path -l"
  fi
  if tmux list-sessions >/dev/null 2>&1; then
    sync_bridge_tmux_environment
    if [[ -r "$HOME/.tmux.conf" ]]; then
      tmux source-file "$HOME/.tmux.conf" || fail "无法重新加载 $HOME/.tmux.conf"
    fi
  fi

  # 已有 dev session 可能仍停在历史 Bash pane。优先选择受管的 zsh/Iris pane；
  # 如果不存在则新建 zsh window，但不终止或改写原有 pane。
  if tmux has-session -t "=$HOST_TMUX_SESSION" 2>/dev/null; then
    zsh_pane=
    while read -r pane_id pane_command; do
      case "$pane_command" in
        zsh|iris)
          zsh_pane=$pane_id
          break
          ;;
      esac
    done < <(tmux list-panes -s -t "=$HOST_TMUX_SESSION" \
      -F "#{pane_id} #{pane_current_command}")
    if [[ -z "$zsh_pane" ]]; then
      zsh_pane=$(tmux new-window -d -P -F "#{pane_id}" -t "$HOST_TMUX_SESSION:" \
        -n shell "$shell_command")
    fi
    zsh_window=$(tmux display-message -p -t "$zsh_pane" "#{window_id}")
    tmux select-window -t "$zsh_window"
    tmux select-pane -t "$zsh_pane"
  fi
  if [[ -r "$HOME/.tmux.conf" ]]; then
    exec tmux -f "$HOME/.tmux.conf" new-session -A -s "$HOST_TMUX_SESSION" "$shell_command"
  fi
  exec tmux new-session -A -s "$HOST_TMUX_SESSION" "$shell_command"
}

enter_container_tmux() {
  local container_id=$1 container_name=$2 termscp_mac_host authorization_output
  local -a docker_environment

  termscp_mac_host=127.0.0.1
  start_termscp_container_relay "$container_id"

  if [[ -n ${TERMSCP_MAC_USER:-} ]]; then
    if ! authorization_output=$(authorize_termscp_container_key \
      "$container_id" "$container_name" "$termscp_mac_host" 2>&1); then
      printf 'remote-dev-entry：无法自动授权容器公钥：%s\n' \
        "$authorization_output" >&2
      printf '%s\n' '仍会进入容器，但 termscp-mac 可能需要手动配置认证。' >&2
    fi
    # 即使授权服务暂时失败，也保持专用 Host，绝不回退读取普通 SSH 身份。
    termscp_mac_host=dotfiles-termscp-mac
  fi
  # 容器镜像可能通过 BASH_ENV/ENV 注入 shell 初始化脚本（例如 Iris）。tmux
  # 状态栏的 #() helper 是非交互子 shell；继承这些脚本会把终端控制序列当作
  # 状态文本显示。显式指向无输出的 /dev/null，也能覆盖已有 tmux server
  # 启动时保存的镜像默认值，避免 unset 后再次回落到原始 Iris hook。
  docker_environment=(
    -e "TERM=${TERM:-xterm-256color}"
    -e "BASH_ENV=/dev/null"
    -e "ENV=/dev/null"
  )
  if [[ -n ${TERMSCP_MAC_USER:-} ]]; then
    docker_environment+=(
      -e "TERMSCP_MAC_USER=$TERMSCP_MAC_USER"
      -e "TERMSCP_REVERSE_PORT=${TERMSCP_REVERSE_PORT:-6022}"
      -e "TERMSCP_MAC_HOST=$termscp_mac_host"
    )
  fi
  # 该路径绝不创建宿主机 tmux。docker exec 取代 SSH 入口进程，后续 tmux
  # 命令只会在容器内解析和启动。
  # 与公钥采集相同，这里必须使用非登录 shell。否则 ~/.profile 可能提前加载
  # Iris 等交互包装器，导致下面的 tmux 入口脚本根本没有机会执行。
  exec docker exec -it "${docker_environment[@]}" "$container_id" sh -c '
    export BASH_ENV=/dev/null
    export ENV=/dev/null
    export PATH="$HOME/.local/bin:$PATH"
    tmux_session=$1

    # 宿主机可能已经安装 xterm-ghostty，而所选容器尚未安装。必须在容器内
    # 再检查一次，否则 tmux/Yazi 会因未知 TERM 无法启动。
    if [ "${TERM:-}" = xterm-ghostty ] &&
      { ! command -v infocmp >/dev/null 2>&1 || ! infocmp xterm-ghostty >/dev/null 2>&1; }; then
      export TERM=xterm-256color
    fi

    utf8_locale=
    if command -v locale >/dev/null 2>&1; then
      utf8_locale=$(locale -a 2>/dev/null | grep -Eim1 "^zh_CN\\.utf-?8$" || true)
      if [ -z "$utf8_locale" ]; then
        utf8_locale=$(locale -a 2>/dev/null | grep -Eim1 "^C\\.utf-?8$" || true)
      fi
    fi
    if [ -n "$utf8_locale" ]; then
      export LANG="$utf8_locale"
      export LC_ALL="$utf8_locale"
    else
      printf "%s\n" "remote-dev-entry：容器内没有可用的 UTF-8 locale，中文可能显示异常" >&2
      printf "%s\n" "请先在容器内运行 dotfiles bootstrap。" >&2
    fi

    if ! command -v tmux >/dev/null 2>&1; then
      printf "%s\n" "remote-dev-entry：容器内未安装 tmux" >&2
      printf "%s\n" "请先在容器内运行 dotfiles bootstrap。" >&2
      exit 127
    fi
    if ! command -v zsh >/dev/null 2>&1; then
      printf "%s\n" "remote-dev-entry：容器内未安装 zsh" >&2
      printf "%s\n" "请先在容器内运行 dotfiles bootstrap。" >&2
      exit 127
    fi
    if [ ! -r "$HOME/.tmux.conf" ]; then
      printf "%s\n" "remote-dev-entry：找不到 $HOME/.tmux.conf" >&2
      printf "%s\n" "请先在容器内运行 dotfiles bootstrap。" >&2
      exit 127
    fi
    # 已运行的 tmux server 会保留启动时的环境，因此附加前需要同步
    # locale，并重新加载受管配置。
    if [ -n "$utf8_locale" ]; then
      tmux set-environment -g LANG "$LANG" 2>/dev/null || true
      tmux set-environment -g LC_ALL "$LC_ALL" 2>/dev/null || true
    fi
    if tmux list-sessions >/dev/null 2>&1; then
      # 已有 server 的进程环境无法原地修改；用全局值覆盖镜像注入的 shell
      # 初始化脚本，再重载受管 tmux 配置。
      tmux set-environment -g BASH_ENV /dev/null 2>/dev/null || true
      tmux set-environment -g ENV /dev/null 2>/dev/null || true
      for variable in TERMSCP_MAC_USER TERMSCP_REVERSE_PORT TERMSCP_MAC_HOST; do
        eval "value=\${$variable:-}"
        [ -n "$value" ] || continue
        tmux set-environment -g "$variable" "$value" 2>/dev/null || true
      done
      tmux source-file "$HOME/.tmux.conf" || {
        printf "%s\n" "remote-dev-entry：无法重新加载 $HOME/.tmux.conf" >&2
        exit 1
      }
    fi

    # 持久 session 可能正指向一个运行其他前台命令的 pane。新客户端优先选择
    # 空闲的受管 shell pane；Iris 会成为 zsh 的外层进程，因此 pane_current_command
    # 在 prompt 处可能是 zsh，也可能是 iris。
    if tmux has-session -t "=$tmux_session" 2>/dev/null; then
      zsh_pane=
      attempt=0
      while [ "$attempt" -lt 10 ] && [ -z "$zsh_pane" ]; do
        set -- $(tmux list-panes -s -t "=$tmux_session" \
          -F "#{pane_id} #{pane_current_command}")
        while [ "$#" -ge 2 ]; do
          pane_id=$1
          pane_command=$2
          shift 2
          case "$pane_command" in
            zsh|iris)
              zsh_pane=$pane_id
              break
              ;;
          esac
        done
        attempt=$((attempt + 1))
        [ -n "$zsh_pane" ] || sleep 0.05
      done
      if [ -z "$zsh_pane" ]; then
        zsh_pane=$(tmux new-window -d -P -F "#{pane_id}" -t "$tmux_session:" -n shell \
          "$HOME/.local/bin/tmux-zsh")
      fi
      zsh_window=$(tmux display-message -p -t "$zsh_pane" "#{window_id}")
      tmux select-window -t "$zsh_window"
      tmux select-pane -t "$zsh_pane"
    fi

    # tmux 必须直接取代容器入口。不能先启动 interactive zsh：Iris 会包装
    # 该 zsh，使外层命令停在 Iris 而未执行 tmux。tmux pane 自身仍会通过
    # ~/.tmux.conf 的 default-command 启动受管 login zsh。
    exec tmux -f "$HOME/.tmux.conf" new-session -A -s "$tmux_session"
  ' sh "$CONTAINER_TMUX_SESSION"
}

terminal_size() {
  # 优先从 stty 读取实际 TTY 尺寸，tput/LINES/COLUMNS 只是兼容回退。
  local size lines columns

  size=$(stty size 2>/dev/null || true)
  if [[ "$size" =~ ^([1-9][0-9]*)[[:space:]]+([1-9][0-9]*)$ ]]; then
    lines=${BASH_REMATCH[1]}
    columns=${BASH_REMATCH[2]}
  else
    lines=$(tput lines 2>/dev/null || true)
    columns=$(tput cols 2>/dev/null || true)
  fi
  [[ "$lines" =~ ^[1-9][0-9]*$ ]] || lines=${LINES:-24}
  [[ "$columns" =~ ^[1-9][0-9]*$ ]] || columns=${COLUMNS:-80}
  [[ "$lines" =~ ^[1-9][0-9]*$ ]] || lines=24
  [[ "$columns" =~ ^[1-9][0-9]*$ ]] || columns=80

  printf '%d %d\n' "$lines" "$columns"
}

repeat_panel_character() {
  local character=$1 count=$2
  local output=

  while ((count > 0)); do
    output+=$character
    count=$((count - 1))
  done
  printf '%s' "$output"
}

choose_container() {
  # 菜单每次外层循环都重新读取 docker ps；内层循环处理翻页、键盘和缩放。
  # REMOTE_DEV_MENU_ROWS 可改每页目标行数，实际行数仍会受终端高度限制。
  local container_output id name image status key key_tail index selected
  local interactive menu_resized read_status
  local configured_page_size page_size page_start page_end available_rows
  local terminal_lines terminal_columns panel_width content_width panel_height
  local panel_row panel_column bottom_row field_width name_width image_width
  local status_width menu_text render_row line_index selected_line
  local panel_title panel_title_width top_border bottom_border
  local purple=$'\033[38;5;141m'
  local selected_style=$'\033[1;38;5;231;48;5;55m'
  local muted=$'\033[38;5;245m'
  local reset=$'\033[0m'
  local -a container_ids=()
  local -a container_names=()
  local -a container_images=()
  local -a container_statuses=()
  local -a menu_lines=()

  command -v docker >/dev/null 2>&1 || fail "宿主机未安装 Docker"
  selected=0
  interactive=0
  menu_resized=0
  if [[ -t 0 && -t 1 ]]; then
    interactive=1
    trap 'menu_resized=1' WINCH
  fi
  configured_page_size=${REMOTE_DEV_MENU_ROWS:-12}
  [[ "$configured_page_size" =~ ^[1-9][0-9]*$ ]] || configured_page_size=12
  while true; do
    container_ids=()
    container_names=()
    container_images=()
    container_statuses=()

    if ! container_output=$(docker ps --format '{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}'); then
      fail "无法列出 Docker 容器，请检查 Docker daemon 和当前用户权限"
    fi

    while IFS=$'\t' read -r id name image status; do
      [[ -n "$id" ]] || continue
      container_ids+=("$id")
      container_names+=("$name")
      container_images+=("$image")
      container_statuses+=("$status")
    done <<< "$container_output"

    if (( ${#container_ids[@]} == 0 )); then
      if (( interactive )); then
        trap - WINCH
        printf '\033[2J\033[H'
      fi
      printf '%s\n' '没有正在运行的容器，将进入宿主机 tmux。'
      enter_host_tmux
      return
    fi

    (( selected < ${#container_ids[@]} )) || selected=0

    while true; do
      menu_resized=0
      page_size=$configured_page_size
      terminal_lines=24
      terminal_columns=80
      if (( interactive )); then
        read -r terminal_lines terminal_columns <<< "$(terminal_size)"
        available_rows=$((terminal_lines - 5))
        (( available_rows > 0 )) || available_rows=1
        (( page_size <= available_rows )) || page_size=$available_rows
      fi
      panel_width=92
      if (( interactive && terminal_columns < panel_width )); then
        panel_width=$terminal_columns
      fi
      ((panel_width >= 16)) || panel_width=16
      content_width=$((panel_width - 4))
      name_width=24
      image_width=32
      status_width=24
      if (( content_width < 88 )); then
        field_width=$((content_width - 8))
        (( field_width >= 3 )) || field_width=3
        name_width=$((field_width * 3 / 10))
        image_width=$((field_width * 4 / 10))
        (( name_width > 0 )) || name_width=1
        (( image_width > 0 )) || image_width=1
        status_width=$((field_width - name_width - image_width))
        (( status_width > 0 )) || status_width=1
      fi

      page_start=$(( (selected / page_size) * page_size ))
      page_end=$((page_start + page_size))
      (( page_end <= ${#container_ids[@]} )) || page_end=${#container_ids[@]}

      menu_lines=()
      if (( interactive && terminal_columns < 60 )); then
        printf -v menu_text 'Docker 容器 %d（%d-%d）' \
          "${#container_ids[@]}" "$((page_start + 1))" "$page_end"
      else
        printf -v menu_text 'Docker 容器（%d 个正在运行，显示 %d-%d）' \
          "${#container_ids[@]}" "$((page_start + 1))" "$page_end"
      fi
      menu_lines+=("$menu_text")
      if (( interactive && terminal_columns < 60 )); then
        menu_lines+=('↑/↓ Enter进入 h宿主机 q退出')
      else
        menu_lines+=('↑/↓ 选择  Enter 进入  r 刷新  h 宿主机  q 退出')
      fi
      printf -v menu_text '  %-3s %-*.*s %-*.*s %-*.*s' '' \
        "$name_width" "$name_width" 'NAME' \
        "$image_width" "$image_width" 'IMAGE' \
        "$status_width" "$status_width" 'STATUS'
      menu_lines+=("$menu_text")

      for ((index = page_start; index < page_end; index++)); do
        if (( index == selected )); then
          printf -v menu_text '  %-3s %-*.*s %-*.*s %-*.*s' '>' \
            "$name_width" "$name_width" "${container_names[$index]}" \
            "$image_width" "$image_width" "${container_images[$index]}" \
            "$status_width" "$status_width" "${container_statuses[$index]}"
        else
          printf -v menu_text '  %-3s %-*.*s %-*.*s %-*.*s' '' \
            "$name_width" "$name_width" "${container_names[$index]}" \
            "$image_width" "$image_width" "${container_images[$index]}" \
            "$status_width" "$status_width" "${container_statuses[$index]}"
        fi
        menu_lines+=("$menu_text")
      done

      if (( interactive )); then
        # 表格内容最宽 88 列，外加圆角紫色边框和左右留白。窄终端按比例压缩
        # 字段；每次缩放都按完整 Panel 重新计算居中位置。
        panel_title=' DOCKER CONTAINERS '
        panel_title_width=19
        if ((panel_width < 24)); then
          panel_title=' DOCKER '
          panel_title_width=8
        fi
        panel_height=$((${#menu_lines[@]} + 2))
        panel_row=$(((terminal_lines - panel_height) / 2 + 1))
        panel_column=$(((terminal_columns - panel_width) / 2 + 1))
        (( panel_row > 0 )) || panel_row=1
        (( panel_column > 0 )) || panel_column=1
        bottom_row=$((panel_row + panel_height - 1))
        selected_line=$((selected - page_start + 3))
        top_border="╭─${panel_title}$(repeat_panel_character '─' \
          "$((panel_width - panel_title_width - 3))")╮"
        bottom_border="╰$(repeat_panel_character '─' "$((panel_width - 2))")╯"

        printf '\033[2J\033[H'
        printf '\033[%d;%dH%s%s%s' \
          "$panel_row" "$panel_column" "$purple" "$top_border" "$reset"
        render_row=$((panel_row + 1))
        line_index=0
        for menu_text in "${menu_lines[@]}"; do
          printf '\033[%d;%dH%s│%s' \
            "$render_row" "$panel_column" "$purple" "$reset"
          printf '\033[%d;%dH%s│%s' \
            "$render_row" "$((panel_column + panel_width - 1))" "$purple" "$reset"
          if ((line_index == selected_line)) && [[ ${TERM:-dumb} != dumb ]]; then
            printf '\033[%d;%dH%s%-*.*s%s' \
              "$render_row" "$((panel_column + 2))" "$selected_style" \
              "$content_width" "$content_width" "$menu_text" "$reset"
          elif ((line_index == 0)); then
            printf '\033[%d;%dH%s%s%s' \
              "$render_row" "$((panel_column + 2))" "$purple" "$menu_text" "$reset"
          elif ((line_index == 1)); then
            printf '\033[%d;%dH%s%s%s' \
              "$render_row" "$((panel_column + 2))" "$muted" "$menu_text" "$reset"
          else
            printf '\033[%d;%dH%s' "$render_row" "$((panel_column + 2))" "$menu_text"
          fi
          render_row=$((render_row + 1))
          line_index=$((line_index + 1))
        done
        printf '\033[%d;%dH%s%s%s' \
          "$bottom_row" "$panel_column" "$purple" "$bottom_border" "$reset"
      else
        printf '%s\n' "${menu_lines[@]}"
      fi

      while true; do
        key=
        read_status=0
        if (( interactive )); then
          # macOS 自带 Bash 3.2，read 只接受整数超时。每秒轮询一次，使 WINCH
          # 设置的重绘标志能快速生效。
          IFS= read -rsn1 -t 1 key || read_status=$?
        else
          IFS= read -rsn1 key || read_status=$?
        fi
        (( menu_resized )) && break
        if (( read_status != 0 && interactive )); then
          continue
        fi
        (( read_status == 0 )) || key=q
        break
      done
      if (( menu_resized )); then
        continue
      fi
      case "$key" in
        '')
          if (( interactive )); then
            trap - WINCH
            printf '\033[2J\033[H'
          fi
          enter_container_tmux "${container_ids[$selected]}" "${container_names[$selected]}"
          return
          ;;
        $'\033')
          key_tail=
          IFS= read -rsn2 -t 1 key_tail || true
          case "$key_tail" in
            '[A') selected=$(( (selected - 1 + ${#container_ids[@]}) % ${#container_ids[@]} )) ;;
            '[B') selected=$(( (selected + 1) % ${#container_ids[@]} )) ;;
          esac
          ;;
        k|K)
          selected=$(( (selected - 1 + ${#container_ids[@]}) % ${#container_ids[@]} ))
          ;;
        j|J)
          selected=$(( (selected + 1) % ${#container_ids[@]} ))
          ;;
        r|R)
          break
          ;;
        h|H)
          if (( interactive )); then
            trap - WINCH
            printf '\033[2J\033[H'
          fi
          enter_host_tmux
          return
          ;;
        q|Q)
          if (( interactive )); then
            trap - WINCH
            printf '\033[2J\033[H'
          fi
          return 0
          ;;
      esac
    done
  done
}

render_docker_prompt() {
  # 初始询问也使用与容器列表一致的紫色圆角 Panel。
  local lines columns panel_width=54 panel_height=5 panel_row panel_column
  local question_row hint_row question_column hint_column bottom_row
  local panel_title=' REMOTE TARGET ' panel_title_width=15
  local question='是否进入 Docker 容器？'
  local hint='Enter  进入容器    Esc  进入宿主机'
  local purple=$'\033[38;5;141m'
  local muted=$'\033[38;5;245m'
  local reset=$'\033[0m'
  local top_border bottom_border row

  read -r lines columns <<< "$(terminal_size)"

  ((panel_width <= columns)) || panel_width=$columns
  ((panel_width >= 20)) || panel_width=20
  panel_row=$(((lines - panel_height) / 2 + 1))
  panel_column=$(((columns - panel_width) / 2 + 1))
  ((panel_row > 0)) || panel_row=1
  ((panel_column > 0)) || panel_column=1
  bottom_row=$((panel_row + panel_height - 1))
  question_row=$((panel_row + 1))
  hint_row=$((panel_row + 3))

  # 这里使用终端显示宽度：中文字符占两列。
  question_column=$((panel_column + (panel_width - 22) / 2))
  hint_column=$((panel_column + (panel_width - 34) / 2))
  ((question_column > panel_column)) || question_column=$((panel_column + 1))
  ((hint_column > panel_column)) || hint_column=$((panel_column + 1))

  top_border="╭─${panel_title}$(repeat_panel_character '─' \
    "$((panel_width - panel_title_width - 3))")╮"
  bottom_border="╰$(repeat_panel_character '─' "$((panel_width - 2))")╯"

  printf '\033[2J\033[H'
  printf '\033[%d;%dH%s%s%s' \
    "$panel_row" "$panel_column" "$purple" "$top_border" "$reset"
  for ((row = panel_row + 1; row < bottom_row; row++)); do
    printf '\033[%d;%dH%s│%s' "$row" "$panel_column" "$purple" "$reset"
    printf '\033[%d;%dH%s│%s' \
      "$row" "$((panel_column + panel_width - 1))" "$purple" "$reset"
  done
  printf '\033[%d;%dH%s%s%s' \
    "$bottom_row" "$panel_column" "$purple" "$bottom_border" "$reset"
  printf '\033[%d;%dH%s%s%s' \
    "$question_row" "$question_column" "$purple" "$question" "$reset"
  printf '\033[%d;%dH%s%s%s' \
    "$hint_row" "$hint_column" "$muted" "$hint" "$reset"
}

read_docker_choice() {
  # 交互 TTY 中 Enter 进容器菜单、Esc 进宿主机；非交互输入结束时安全回退宿主机。
  local answer read_status interactive prompt_resized

  DOCKER_CHOICE=host
  interactive=0
  prompt_resized=0
  if [[ -t 0 && -t 1 ]]; then
    interactive=1
    prompt_resized=1
    trap 'prompt_resized=1' WINCH
  else
    printf '%s' '是否进入 Docker 容器？Enter：进入  Esc：进入宿主机 '
  fi

  while true; do
    if (( prompt_resized )); then
      render_docker_prompt
      prompt_resized=0
    fi
    answer=
    read_status=0
    if (( interactive )); then
      IFS= read -rsn1 -t 1 answer || read_status=$?
    else
      IFS= read -rsn1 answer || read_status=$?
    fi
    if (( read_status == 0 )); then
      case "$answer" in
        '')
          DOCKER_CHOICE=container
          break
          ;;
        $'\033')
          DOCKER_CHOICE=host
          break
          ;;
        *)
          (( interactive == 0 )) || printf '\a'
          ;;
      esac
    else
      if (( interactive )); then
        continue
      fi
      DOCKER_CHOICE=host
      break
    fi
  done

  if (( interactive )); then
    trap - WINCH
    printf '\033[2J\033[H'
  fi
}

main() {
  read_docker_choice

  case "$DOCKER_CHOICE" in
    container)
      choose_container
      ;;
    *)
      enter_host_tmux
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
