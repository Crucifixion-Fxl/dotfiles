#!/usr/bin/env bash

set -uo pipefail

# Ghostty 1.3.1 的 AppleScript surface 偶尔会忽略 wait-after-command=false。
# 本 wrapper 等待启动脚本写入新 tab 的稳定 ID，运行真正的远端入口，并在入口
# 结束（包括 tmux detach）后只关闭该 tab，不依赖届时哪个窗口或 tab 在前台。

fail() {
  printf 'ghostty-tab-command：%s\n' "$*" >&2
  exit 1
}

[[ $# -eq 4 ]] || fail "用法：ghostty-tab-command <state-dir> <close-script> <command> <argument>"

state_directory=$1
close_script=$2
command_path=$3
command_argument=$4
tab_id_file="$state_directory/tab-id"
osascript_binary=${GHOSTTY_OSASCRIPT_BIN:-/usr/bin/osascript}

[[ -d "$state_directory" && ${state_directory##*/} == ghostty-dev.* ]] || \
  fail "无效的状态目录 $state_directory"
[[ -r "$close_script" ]] || fail "找不到关闭 tab 的脚本 $close_script"
[[ -x "$command_path" ]] || fail "找不到可执行入口 $command_path"
[[ -x "$osascript_binary" ]] || fail "找不到 osascript $osascript_binary"

cleanup() {
  if [[ -e "$tab_id_file" ]]; then
    unlink "$tab_id_file" 2>/dev/null || true
  fi
  rmdir "$state_directory" 2>/dev/null || true
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

for ((attempt = 0; attempt < 500; attempt++)); do
  [[ -s "$tab_id_file" ]] && break
  sleep 0.01
done
[[ -s "$tab_id_file" ]] || fail "等待 Ghostty tab ID 超时"

IFS= read -r tab_id < "$tab_id_file"
[[ -n "$tab_id" ]] || fail "Ghostty tab ID 为空"

"$command_path" "$command_argument"
command_status=$?

# 先清理状态目录，再请求 Ghostty 关闭本 tab。关闭动作会终止当前 pty 中的进程，
# 因此不能把清理留到 osascript 返回之后。
trap - EXIT
cleanup
if ! "$osascript_binary" "$close_script" "$tab_id"; then
  printf 'ghostty-tab-command：无法自动关闭 Ghostty tab %s\n' "$tab_id" >&2
  exit "$command_status"
fi

exit "$command_status"
