# : << 'EOF'
# =============================================================================
# Oh My Tmux 本地配置
#
# bootstrap 将官方锁定版本链接为 ~/.tmux.conf，并将本文件链接为
# ~/.tmux.conf.local。主题由 Oh My Tmux 渲染；原有交互、弹窗、插件和
# container-local tmux 行为继续由下面带 #!important 的覆盖项保持。
# =============================================================================


# --- Oh My Tmux 行为 ---------------------------------------------------------
# 保留 tmux 原生绑定；Oh My Tmux 只增加不冲突的功能。
tmux_conf_preserve_stock_bindings=true

# TPM、resurrect 和 continuum 均由 bootstrap 锁定 commit，不允许框架在
# tmux 启动或重载时自行升级。
tmux_conf_update_plugins_on_launch=false
tmux_conf_update_plugins_on_reload=false
tmux_conf_uninstall_plugins_on_reload=false


# --- Nord 主题 ---------------------------------------------------------------
# Nord palette:
#   nord0  #2e3440    nord1  #3b4252    nord2  #434c5e
#   nord4  #d8dee9    nord5  #e5e9f0    nord6  #eceff4
#   nord7  #8fbcbb    nord10 #5e81ac
tmux_conf_theme=enabled
tmux_conf_theme_status_fg="#d8dee9"
tmux_conf_theme_status_bg="#2e3440"
tmux_conf_theme_status_attr="none"

# Ghostty 的原生 Tab UI 不稳定渲染 Oh My Tmux 默认标题中的 ❐/●。保留相同
# 信息，但只使用 ASCII，避免标题栏出现缺字占位符。
tmux_conf_theme_terminal_title="#h | #S | #I #W"

# 普通 window。
tmux_conf_theme_window_status_fg="#e5e9f0"
tmux_conf_theme_window_status_bg="#3b4252"
tmux_conf_theme_window_status_attr="none"
tmux_conf_theme_window_status_format="#I #W"

# 当前 window。
tmux_conf_theme_window_status_current_fg="#eceff4"
tmux_conf_theme_window_status_current_bg="#5e81ac"
tmux_conf_theme_window_status_current_attr="bold"
tmux_conf_theme_window_status_current_format=" #W"

tmux_conf_theme_window_status_activity_fg="default"
tmux_conf_theme_window_status_activity_bg="default"
tmux_conf_theme_window_status_activity_attr="underscore"

tmux_conf_theme_window_status_bell_fg="#ffff00"
tmux_conf_theme_window_status_bell_bg="default"
tmux_conf_theme_window_status_bell_attr="blink,bold"

tmux_conf_theme_window_status_last_fg="default"
tmux_conf_theme_window_status_last_bg="default"
tmux_conf_theme_window_status_last_attr="none"
tmux_conf_theme_window_status_last_format="#I #W-"

# 左侧一个 section；右侧四个 section，颜色和属性数量严格一一对应。
# 第一段由受管脚本生成：Mac 显示电量条，Linux/容器显示系统负载条。
tmux_conf_theme_status_left="  #S "
tmux_conf_theme_status_left_fg="#e5e9f0"
tmux_conf_theme_status_left_bg="#2e3440"
tmux_conf_theme_status_left_attr="bold"

tmux_conf_theme_status_right='#{prefix}#{pairing}#{synchronized}#($HOME/.tmux/system-meter.sh) | 󰃭 %b %d |  %R |  #{username} '
tmux_conf_theme_status_right_fg="#d8dee9,#eceff4,#eceff4,#e5e9f0"
tmux_conf_theme_status_right_bg="#3b4252,#8fbcbb,#5e81ac,#434c5e"
tmux_conf_theme_status_right_attr="bold,none,bold,none"


# --- 保留现有 tmux 行为 ------------------------------------------------------
# 仍以 Ctrl-b 为唯一 Prefix；Oh My Tmux 默认增加的 Ctrl-a 被显式关闭。
set -gu prefix2 #!important
unbind-key C-a #!important

# 保留原生 0 起始编号和关闭 window 后不自动重编号的现有行为。
set -g base-index 0 #!important
set -gw pane-base-index 0 #!important
set -g renumber-windows off #!important

set -g default-terminal tmux-256color #!important
set -g mouse on #!important
set -g history-limit 100000 #!important
set -g set-clipboard external #!important
set -g status on #!important

# shell/tmux-window-name.zsh 负责生成目录名或命令名；禁止终端程序任意改名。
set -gw automatic-rename on #!important
set -g allow-rename off #!important

# Prefix+< / Prefix+>：调整当前 window 的左右顺序。
bind-key < swap-window -d -t -1 #!important
bind-key > swap-window -d -t +1 #!important


# --- Shell 与弹窗 ------------------------------------------------------------
set -g default-command '$HOME/.local/bin/tmux-zsh' #!important
bind-key t display-popup -E -w 90% -h 90% -d "#{pane_current_path}" 'TMUX_POPUP=1 exec "$HOME/.local/bin/tmux-zsh"' #!important


# --- lazygit -----------------------------------------------------------------
bind-key g display-popup -E -w 90% -h 90% -d "#{pane_current_path}" 'exec "$HOME/.local/bin/lazygit-safe"' #!important
bind-key G new-window -n lazygit -c "#{pane_current_path}" 'exec "$HOME/.local/bin/lazygit-safe"' #!important


# --- Session 选择器 ----------------------------------------------------------
# Prefix+s 显示每个 session 内 Codex 的运行、等待输入和完成数量。
bind-key s choose-tree -Zs -F '#{?session_format,#{session_name} (#{session_windows} windows)  #($HOME/.tmux/session-status-counts.sh #{q:session_id}),#{?window_format,#{window_index}: #{window_name} (#{window_panes} panes),#{pane_index}: #{pane_title}}}' #!important


# --- 锁定插件 ---------------------------------------------------------------
# Oh My Tmux 内建 TPM 集成；不要声明 tpm 本身，也不要手动 run tpm。
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @continuum-save-interval '15'
set -g @continuum-restore 'off'
set -g @resurrect-save 'S'
set -g @resurrect-restore 'R'
set -g @resurrect-capture-pane-contents 'off'


# Oh My Tmux 将本文件同时当作 tmux 配置和 shell 输入读取。不要删除下面两行。
# EOF
#
# "$@"
