{
  "title": "Dotfiles tmux input source",
  "rules": [
    {
      "description": "Dotfiles: Ctrl+B selects English and sends tmux prefix in Ghostty",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": {
              "optional": [
                "control",
                "caps_lock"
              ]
            }
          },
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$"
              ]
            },
            {
              "type": "variable_if",
              "name": "dotfiles_tmux_restore_chinese",
              "value": 1
            }
          ],
          "to": [
            {
              "from_event": true,
              "repeat": false
            },
            {
              "set_variable": {
                "name": "dotfiles_tmux_restore_chinese",
                "value": 0
              }
            }
          ],
          "to_after_key_up": [
            {
              "select_input_source": {
                "input_source_id": "^com\\.tencent\\.inputmethod\\.wetype\\.pinyin$"
              },
              "conditions": [
                {
                  "type": "frontmost_application_if",
                  "bundle_identifiers": [
                    "^com\\.mitchellh\\.ghostty$"
                  ]
                },
                {
                  "type": "input_source_if",
                  "input_sources": [
                    {
                      "input_source_id": "^com\\.apple\\.keylayout\\.(ABC|US)$"
                    }
                  ]
                }
              ]
            }
          ]
        },
