#!/usr/bin/env python3

import json
import sys

request = json.load(sys.stdin)
if request.get("action") == "fail":
    json.dump({"ok": False, "error": "expected failure"}, sys.stdout)
    sys.exit(1)
json.dump(
    {
        "ok": True,
        "lists": [{"id": "work", "name": "工作"}],
        "tasks": [],
        "received_action": request.get("action"),
    },
    sys.stdout,
    ensure_ascii=False,
)
